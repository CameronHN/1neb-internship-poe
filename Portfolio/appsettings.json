{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDb;Database=ProjectDb;Trusted_Connection=True;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "Pdf": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "Demo": {
      "BurstLimit": 2,
      "BurstWindowSeconds": 60,
      "DailyLimit": 3
    },
    "PdfConcurrency": {
      "PermitLimit": 4,
      "QueueLimit": 2
    }
  }
}
