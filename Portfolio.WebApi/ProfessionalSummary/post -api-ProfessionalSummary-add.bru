meta {
  name: post -api-ProfessionalSummary-add
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/ProfessionalSummary/add
  body: json
  auth: none
}

body:json {
  [
    {
      "summary": ""
    }
  ]
}

docs {
  Adds one or more summaries for the logged-in user. Requires login.

  Body: array of objects.
  - `summary`: required, max 200 characters, not blank

  Returns `201` with the new ids (array of GUIDs). `400` if validation fails.
}
