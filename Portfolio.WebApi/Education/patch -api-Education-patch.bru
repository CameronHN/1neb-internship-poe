patch {
  url: {{baseUrl}}/api/Education/patch
  body: json
  auth: none
}

body:json {
  {
    "id": "",
    "institutionName": "",
    "qualification": "",
    "startDate": "",
    "endDate": "",
    "major": "",
    "achievement": ""
  }
}

docs {
  Updates one education entry. Requires login.

  Body: object. Send `id` and only the fields to change.

  Returns `200 true` if something changed. `204` if nothing changed or the id is not yours. `400` if validation fails.
}
