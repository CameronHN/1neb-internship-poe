meta {
  name: get -api-Education--id
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/Education/:id
  body: none
  auth: none
}

params:path {
  id: 
}

docs {
  Gets one education entry by id. Requires login.

  Path: `id` is a GUID returned by Add.

  Returns `200` with the education entry. `404` if it does not exist or is not yours.
}
