meta {
  name: post -api-Skill-add
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/Skill/add
  body: json
  auth: none
}

body:json {
  [
    {
      "skill": "",
      "proficiencyLevel": ""
    }
  ]
}

docs {
  Adds one or more skills for the logged-in user. Requires login.

  Body: array of objects.
  - `skill`: required, max 200 characters, not blank
  - `proficiencyLevel`: optional, max 200 characters

  Returns `201` with the new ids (array of GUIDs). `400` if validation fails.
}
