meta {
  name: post -api-SavedResume-save
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/SavedResume/save
  body: json
  auth: none
}

body:json {
  {
    "savedResumeName": "",
    "resumeData": {
      "name": "",
      "title": "",
      "email": "",
      "phoneNumber": "",
      "summary": "",
      "skills": [
        {
          "skill": "",
          "skillLevel": ""
        }
      ],
      "professionalLinks": [
        {
          "link": "",
          "linkType": ""
        }
      ],
      "experience": [
        {
          "company": "",
          "jobTitle": "",
          "startDate": "",
          "endDate": "",
          "responsibilities": []
        }
      ],
      "education": [
        {
          "institution": "",
          "qualification": "",
          "startDate": "",
          "endDate": "",
          "major": "",
          "achievement": ""
        }
      ],
      "certification": [
        {
          "name": "",
          "organisation": "",
          "credentialUrl": "",
          "issuedDate": "",
          "expirationDate": ""
        }
      ],
      "sectionOrder": ["experience", "skills", "education", "certifications"]
    },
    "templateType": "classic"
  }
}

docs {
  Saves a snapshot of a resume. Requires login.

  Body:
  - `savedResumeName`: required, max 200 characters
  - `resumeData`: required, same fields and max lengths as `Resume/create-pdf`, but up to 20 items in each list and 20 responsibilities per experience
  - `resumeData.sectionOrder` (optional): the top-to-bottom order of the movable sections, using `skills`, `experience`, `education` and `certifications`. It is saved with the resume and used when the PDF is made. The header and the Summary always come first and cannot be moved, so `summary`, `title` and `links` are rejected, as are unknown keys, duplicates and more than 4 entries (`400`). Keys are not case-sensitive and are stored in lower case. Sections you leave out follow in the template's default order (`classic`: `experience`, `skills`, `education`, `certifications`; `simplified`: `skills`, `experience`, `education`, `certifications`). Leave it out (or send `null` or `[]`) for the default order.
  - `templateType`: required, `classic` or `simplified`

  The body must be under 256 KB. A user can keep up to 50 saved resumes.

  Returns `201` with the new id (a GUID). `400` if validation fails. `413` if the body is too large. `422` if the user already has 50 saved resumes (delete one first). `501` for any other template type.
}
