  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/SavedResume/save
  body: json
  auth: none
}

body:json {
  {
    "savedResumeName": "",
    "resumeData": {
      "name": "",
      "title": "",
      "email": "",
      "phoneNumber": "",
      "summary": "",
      "skills": [
        {
          "skill": "",
          "skillLevel": ""
        }
      ],
      "professionalLinks": [
        {
          "link": "",
          "linkType": ""
        }
      ],
      "experience": [
        {
          "company": "",
          "jobTitle": "",
          "startDate": "",
          "endDate": "",
          "responsibilities": []
        }
      ],
      "education": [
        {
          "institution": "",
          "qualification": "",
          "startDate": "",
          "endDate": "",
          "major": "",
          "achievement": ""
        }
      ],
      "certification": [
        {
          "name": "",
          "organisation": "",
          "credentialUrl": "",
          "issuedDate": "",
          "expirationDate": ""
        }
      ]
    },
    "templateType": "classic"
  }
}

docs {
  Saves a snapshot of a resume. Requires login.

  Body:
  - `savedResumeName`: required, max 200 characters
  - `resumeData`: required, same fields as `Resume/create-pdf`
  - `templateType`: required, `classic` or `simplified`

  Returns `201` with the new id (a GUID). `400` if validation fails. `501` for any other template type.
}
