meta {
  name: get -api-SavedResume--id-pdf
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/SavedResume/:id/pdf
  body: none
  auth: none
}

params:path {
  id: 
}

docs {
  Builds the PDF of one saved resume, using its saved template. Requires login.

  Path: `id` is the GUID returned by Save or List.

  Returns `200` with a PDF (`application/pdf`). `404` if it does not exist or is not yours. `429` after 10 PDFs a minute for one user, or when the server is already making too many PDFs.
}
