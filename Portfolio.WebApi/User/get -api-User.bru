meta {
  name: get -api-User
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/User
  body: none
  auth: none
}

docs {
  Gets the logged-in user's details. Requires login. Takes no parameters: the user comes from the login cookie, so you cannot read anyone else's details.

  Returns `200` with `{ firstName, lastName, email, phoneNumber }`. `401` if not logged in.
}
