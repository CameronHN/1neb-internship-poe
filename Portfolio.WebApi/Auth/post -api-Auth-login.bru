meta {
  name: post -api-Auth-login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/Auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "",
    "password": "",
    "rememberMe": false
  }
}

docs {
  Signs in and sets the auth cookie. No login needed.

  Body: `email`, `password`, `rememberMe` (`true` or `false`).

  Returns `200` with `{ message, userId }`. `400` if the login is invalid, or the account is locked (5 failed attempts lock it for 5 minutes).
}
