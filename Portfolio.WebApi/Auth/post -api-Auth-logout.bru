meta {
  name: post -api-Auth-logout
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/Auth/logout
  body: json
  auth: none
}

body:json {
  {}
}

docs {
  Signs out and clears the auth cookie. Also ends the user's sessions on every other device. Requests after this need a new login.

  Body: `{}`. A JSON body is required so that another website cannot log users out.

  Returns `200`. `415` without a JSON body.
}
