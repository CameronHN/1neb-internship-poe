meta {
  name: post -api-Auth-change-password
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/Auth/change-password
  body: json
  auth: none
}

body:json {
  {
    "currentPassword": "",
    "newPassword": ""
  }
}

docs {
  Changes the logged-in user's password. Requires login.

  Body: `currentPassword`, `newPassword` (same rules as register). This session stays logged in; every other session for the user is logged out. Log in with the new password from now on.

  Returns `200`. `400` if the current password is wrong or the new one breaks the rules. `401` if not logged in. `429` after 10 auth requests a minute from one IP.
}
