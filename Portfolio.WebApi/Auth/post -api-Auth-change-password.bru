meta {
  name: post -api-Auth-change-password
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/Auth/change-password
  body: json
  auth: none
}

body:json {
  {
    "currentPassword": "",
    "newPassword": ""
  }
}

docs {
  Changes the logged-in user's password. Requires login.

  Body: `currentPassword`, `newPassword` (same rules as register). After this, log in with the new password.

  Returns `200`. `400` if the current password is wrong or the new one breaks the rules. `401` if not logged in.
}
