meta {
  name: get -api-Title--id
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/Title/:id
  body: none
  auth: none
}

params:path {
  id: 
}

docs {
  Gets one title by id. Requires login.

  Path: `id` is a GUID returned by Add.

  Returns `200` with the title text. `404` if it does not exist or is not yours.
}
