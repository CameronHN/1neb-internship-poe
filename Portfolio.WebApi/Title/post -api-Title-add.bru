meta {
  name: post -api-Title-add
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/Title/add
  body: json
  auth: none
}

body:json {
  [
    {
      "title": ""
    }
  ]
}

docs {
  Adds one or more titles for the logged-in user. Requires login.

  Body: array of objects.
  - `title`: required, max 100 characters, not blank

  Returns `201` with the new ids (array of GUIDs). `400` if validation fails.
}
