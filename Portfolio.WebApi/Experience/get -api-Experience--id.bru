meta {
  name: get -api-Experience--id
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/Experience/:id
  body: none
  auth: none
}

params:path {
  id: 
}

docs {
  Gets one experience by id. Requires login.

  Path: `id` is a GUID returned by Add.

  Returns `200` with the experience with its responsibilities (each has an id). `404` if it does not exist or is not yours.
}
