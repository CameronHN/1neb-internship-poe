meta {
  name: get -api-Certification--id
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/Certification/:id
  body: none
  auth: none
}

params:path {
  id: 
}

docs {
  Gets one certification by id. Requires login.

  Path: `id` is a GUID returned by Add.

  Returns `200` with the certification. `404` if it does not exist or is not yours.
}
