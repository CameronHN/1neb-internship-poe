meta {
  name: patch -api-Certification-patch
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/api/Certification/patch
  body: json
  auth: none
}

body:json {
  {
    "id": "",
    "certificationName": "",
    "issuingOrganisation": "",
    "credentialUrl": "",
    "issuedDate": "",
    "expiryDate": ""
  }
}

docs {
  Updates one certification. Requires login.

  Body: object. Send `id` and only the fields to change.

  Returns `200 true` if something changed. `204` if nothing changed or the id is not yours. `400` if validation fails.
}
