  url: {{baseUrl}}/api/Resume/get-resume
  body: json
  auth: none
}

body:json {
  {
    "titleId": "",
    "professionalSummaryId": "",
    "socialMediaIds": {
      "ids": [],
      "order": 0
    },
    "experienceIds": {
      "ids": [],
      "order": 0
    },
    "educationIds": {
      "ids": [],
      "order": 0
    },
